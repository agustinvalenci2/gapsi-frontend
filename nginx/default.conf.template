server {
    # Cloud Run inyecta PORT (8080 por defecto).
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # El backend se resuelve por DNS en cada petición: si no está disponible,
    # /api responde 502 pero el contenedor arranca igual (requisito de Cloud Run).
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
    resolver_timeout 5s;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Proxy al backend: el navegador llama a /api/v1/... en el mismo origen (sin CORS).
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        # Host del upstream (necesario si el backend también está en Cloud Run / HTTPS).
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check para Cloud Run / balanceadores.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Archivos con hash: caché larga.
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta devuelve index.html (para el router de Angular).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
